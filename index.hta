<!DOCTYPE html>
<html>
<head>
    <title>Just a Square</title>
    <hta:application id="objHTA" applicationname="MoveBox" border="thick" caption="yes" navigable="yes" windowstate="normal">
    <script type="text/javascript">
        window.onload = function() {
            var square = document.createElement('div');
            square.style.width = '500px';
            square.style.height = '500px';
            square.style.backgroundColor = 'grey';
            square.style.position = 'absolute';
            square.style.left = '0px';
            square.style.top = '0px';
            document.body.appendChild(square);
            var positionX = 0;
            var speed = 10;
            document.onkeydown = function() {
                var event = window.event; // IE event model support
                var key = String.fromCharCode(event.keyCode);
                if (key === 'A' || event.keyCode === 37) { // 'A' or ArrowLeft (37)
                    positionX -= speed;
                } else if (key === 'D' || event.keyCode === 39) { // 'D' or ArrowRight (39)
                    positionX += speed;
                }
                square.style.left = positionX + 'px';
            };
        };
    </script>
</head>
<body>
</body>
</html>

